---
import "../../styles/components/free-check.css";
---

<div
  class="cta-popup"
  id="ctaPopup"
  role="dialog"
  aria-modal="true"
  aria-labelledby="ctaPopupTitle"
  aria-hidden="true"
>
  <div class="cta-popup-box">

    <button
      class="close cta-popup-close"
      type="button"
      aria-label="Chiudi popup"
    >
      ×
    </button>

    <div class="cta-form-content">
      <h2 id="ctaPopupTitle">Controllo gratuito</h2>

      <p>
        Passa direttamente in sede oppure lasciaci il numero.
        Ti richiamiamo entro pochi minuti.
      </p>

      <form id="ctaForm" novalidate>
        <input
          type="text"
          name="name"
          placeholder="Nome"
          autocomplete="name"
          required
        />

        <input
          type="tel"
          name="phone"
          placeholder="Telefono"
          autocomplete="tel"
          inputmode="tel"
          required
        />

        <input
          type="text"
          name="city"
          placeholder="Città"
          autocomplete="address-level2"
          required
        />

        <button type="submit">
          Ti richiamiamo subito
        </button>
      </form>
    </div>

    <div class="cta-success" hidden>
      <h3>✅ Richiesta inviata</h3>
      <p>Ti richiamiamo a breve.</p>
    </div>

  </div>
</div>

<script is:inline>
document.addEventListener("DOMContentLoaded", () => {
  const buttons = document.querySelectorAll(".open-cta");
  const popup = document.getElementById("ctaPopup");

  if (!buttons.length || !popup) return;

  const form = popup.querySelector("#ctaForm");
  const formContent = popup.querySelector(".cta-form-content");
  const successBox = popup.querySelector(".cta-success");
  const closeButton = popup.querySelector(".cta-popup-close");
  const phoneInput = popup.querySelector('input[name="phone"]');

  if (!form || !formContent || !successBox || !closeButton || !phoneInput) return;

  const submitButton = form.querySelector('button[type="submit"]');

  const resetPopup = () => {
    form.reset();
    formContent.hidden = false;
    successBox.hidden = true;

    if (submitButton) {
      submitButton.disabled = false;
      submitButton.textContent = "Ti richiamiamo subito";
    }
  };

  const openPopup = () => {
    resetPopup();

    popup.classList.add("active");
    popup.setAttribute("aria-hidden", "false");
    document.body.classList.add("modal-open");

    setTimeout(() => {
      const firstInput = form.querySelector("input");
      firstInput?.focus();
    }, 120);
  };

  const closePopup = () => {
    popup.classList.remove("active");
    popup.setAttribute("aria-hidden", "true");
    document.body.classList.remove("modal-open");

    setTimeout(resetPopup, 250);
  };

  buttons.forEach((button) => {
    button.addEventListener("click", (event) => {
      event.preventDefault();
      openPopup();
    });
  });

  closeButton.addEventListener("click", closePopup);

  popup.addEventListener("click", (event) => {
    if (event.target === popup) {
      closePopup();
    }
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && popup.classList.contains("active")) {
      closePopup();
    }
  });

  phoneInput.addEventListener("input", () => {
    phoneInput.value = phoneInput.value.replace(/[^\d+]/g, "");
  });

  form.addEventListener("submit", async (event) => {
    event.preventDefault();

    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    if (!submitButton) return;

    submitButton.disabled = true;
    submitButton.textContent = "Invio...";

    const data = new FormData(form);

    try {
      const response = await fetch("/api/contact/", {
        method: "POST",
        body: data,
      });

      const result = await response.json().catch(() => null);

      if (!response.ok || !result?.success) {
        throw new Error(result?.error || "Errore server");
      }

      formContent.hidden = true;
      successBox.hidden = false;

      setTimeout(closePopup, 1800);

    } catch (error) {
      console.error(error);

      submitButton.disabled = false;
      submitButton.textContent = "Ti richiamiamo subito";

      alert("Non siamo riusciti a inviare la richiesta. Puoi chiamarci direttamente al numero 0523 165 6743.");
    }
  });
});
</script>