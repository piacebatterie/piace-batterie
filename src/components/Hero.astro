---
import "../styles/hero.css";
---

<section class="hero" aria-label="Piace Batterie - centro batterie a Piacenza">

  <!-- BACKGROUND -->
  <div class="hero-bg" aria-hidden="true">

    <!-- HERO PRINCIPALE / LCP -->
    <img 
      src="/batteria2.webp" 
      alt="Installazione batteria auto a Piacenza"
      class="active"
      fetchpriority="high"
      loading="eager"
      decoding="async"
      width="1600"
      height="900"
    />

    <!-- ALTRE IMMAGINI SLIDER DESKTOP -->
    <img 
      src="/batteria.webp" 
      alt="Batterie auto professionali disponibili a Piacenza"
      loading="lazy"
      decoding="async"
      width="1600"
      height="900"
    />

    <img 
      src="/batteria3.webp" 
      alt="Test batteria auto con diagnostica professionale"
      loading="lazy"
      decoding="async"
      width="1600"
      height="900"
    />

    <img 
      src="/carrello.webp" 
      alt="Batterie industriali per muletti e carrelli elevatori"
      loading="lazy"
      decoding="async"
      width="1600"
      height="900"
    />

  </div>

  <!-- CONTENUTO -->
  <div class="container hero-inner">

    <div class="hero-text">

      <div class="hero-badge">
        ⚡ Centro batterie a Piacenza
      </div>

      <h1>
        Batterie auto, moto e industriali a Piacenza.
        <span>L’energia che Piace.</span>
      </h1>

      <p class="hero-main">
        Test batteria gratuito in 5 minuti, vendita, installazione immediata e assistenza professionale per auto, furgoni, moto, muletti e mezzi da lavoro.
      </p>

      <p class="hero-sub">
        Tecnologie premium, tecnici specializzati e soluzioni pronte per privati, aziende, flotte e veicoli industriali.
      </p>

      <p class="hero-punch">
        Entra quando vuoi. Controlliamo la batteria. Riparti subito.
      </p>

      <div class="hero-buttons">

        <a href="/contatti" class="btn primary">
          Controllo gratuito in 5 minuti
        </a>

        <a href="tel:+3905231656743" class="btn secondary" aria-label="Chiama Piace Batterie al numero 0523 165 6743">
          📞 Chiama ora 0523 165 6743
        </a>

      </div>

      <div class="hero-trust" aria-label="Vantaggi principali">
        <span>✔ Nessuna attesa</span>
        <span>✔ Test in 5 minuti</span>
        <span>✔ Montaggio immediato</span>
      </div>

    </div>

  </div>

</section>

<script is:inline>
  window.addEventListener("DOMContentLoaded", () => {
    if (window.innerWidth <= 768) return;

    const images = document.querySelectorAll(".hero-bg img");
    if (!images.length) return;

    let index = 0;

    setInterval(() => {
      images[index].classList.remove("active");
      index = (index + 1) % images.length;
      images[index].classList.add("active");
    }, 4000);
  });
</script>

<script is:inline>
  document.querySelector(".hero")?.classList.add("in-view");
</script>