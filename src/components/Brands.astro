---
import "../styles/brands.css";
---

<section class="brands" aria-labelledby="brands-title">
  <div class="container">

    <p class="brands-label">
      Marchi batterie trattati
    </p>

    <h2 id="brands-title" class="brands-title">
      Batterie delle migliori marche per auto, moto, industria e tempo libero
    </h2>

    <p class="brands-intro">
      Da Piace Batterie selezioniamo accumulatori affidabili per ogni applicazione:
      avviamento, trazione, cicli profondi, mezzi industriali, golf car e sistemi al litio.
    </p>

    <div class="brands-grid" aria-label="Marchi di batterie disponibili da Piace Batterie">

      <img 
        src="/logos/FIAMM_logo.webp" 
        alt="Batterie FIAMM" 
        width="800" 
        height="400" 
        loading="lazy" 
        decoding="async"
      />

      <img 
        src="/logos/Magneti_Marelli_logo.webp" 
        alt="Batterie Magneti Marelli" 
        width="800" 
        height="400" 
        loading="lazy" 
        decoding="async"
      />

      <img 
        src="/logos/NPP_logo.webp" 
        alt="Batterie NPP" 
        width="800" 
        height="400" 
        loading="lazy" 
        decoding="async"
      />

      <img 
        src="/logos/BAREN-logo.webp" 
        alt="Batterie Baren" 
        width="800" 
        height="400" 
        loading="lazy" 
        decoding="async"
      />

      <img 
        src="/logos/RITAR_logo.webp" 
        alt="Batterie Ritar Power" 
        width="800" 
        height="400" 
        loading="lazy" 
        decoding="async"
      />

      <img 
        src="/logos/Yuasa_logo.webp" 
        alt="Batterie Yuasa" 
        width="800" 
        height="400" 
        loading="lazy" 
        decoding="async"
      />

      <img 
        src="/logos/okyami_logo.webp" 
        alt="Batterie Okyami" 
        width="800" 
        height="400" 
        loading="lazy" 
        decoding="async"
      />

      <img 
        src="/logos/polinovel_logo.webp" 
        alt="Batterie Polinovel per golf car e litio" 
        width="800" 
        height="400" 
        loading="lazy" 
        decoding="async"
      />

      <img 
        src="/logos/Elhim-ISKRA-logo.webp" 
        alt="Batterie Elhim Iskra" 
        width="800" 
        height="400" 
        loading="lazy" 
        decoding="async"
      />

      <img 
        src="/logos/logo_power_motor_sport.webp" 
        alt="Batterie Power Motor Sport" 
        width="800" 
        height="400" 
        loading="lazy" 
        decoding="async"
      />

      <img 
        src="/logos/sinergy_logo.webp" 
        alt="Batterie Sinergy" 
        width="800" 
        height="400" 
        loading="lazy" 
        decoding="async"
      />

    </div>

    <div class="brands-noise" aria-hidden="true"></div>

  </div>
</section>